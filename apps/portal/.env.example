# portal (Vite) — estas variables se INYECTAN en el bundle en build.
# ⚠ NO poner secretos reales: todo VITE_* es visible para cualquiera que abra el portal.

# URL del backend hub-api
VITE_HUB_API_URL=https://api.ambientalia.cloud

# Clave enviada como x-api-key. OJO: viaja al cliente → no es un secreto real
# (ver SEC-001 en AUDIT_REPORT.md; sustituir por auth server-side).
VITE_HUB_API_KEY=
