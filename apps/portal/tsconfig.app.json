{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // El portal empaqueta el código fuente de cada sub-app (lazy imports). Las
    // reglas de ESTILO (import-type-only y variables sin usar) se relajan en este
    // gate de integración para poder incorporar apps escritas con otra convención
    // (p. ej. customer-valuation); cada app mantiene su propio build. Con noEmit:true
    // vite/esbuild hace la emisión, así que esto no afecta al runtime. La seguridad
    // de tipos real (strict:true) se conserva.
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
