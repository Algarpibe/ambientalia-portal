# hub-api — variables de entorno (backend read-only hacia la DB zoho-hub)
# Copiar a .env y rellenar. NO commitear el .env real.

# Conexión read-only a Postgres (usuario con solo SELECT)
HUB_DB_URL=postgres://usuario:password@host:5432/zoho-hub

# Clave exigida por los endpoints /api/* en el header x-api-key
API_KEY=

# Orígenes CORS permitidos (coma-separado). FAIL-CLOSED: si queda vacío, el
# navegador bloqueará las peticiones cross-origin. Fijar el/los origen(es) del portal.
ALLOWED_ORIGIN=https://portal.tu-dominio.com

# Puerto de escucha
PORT=3001
