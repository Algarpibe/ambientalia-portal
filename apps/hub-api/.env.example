# hub-api — variables de entorno (backend read-only hacia la DB zoho-hub)
# Copiar a .env y rellenar. NO commitear el .env real.

# Conexión read-only a Postgres (usuario con solo SELECT)
HUB_DB_URL=postgres://usuario:password@host:5432/zoho-hub

# Auth JWT (SEC-001/SEC-003). /api/login valida credenciales y emite un JWT.
# JWT_SECRET: secreto para firmar/verificar (obligatorio; sin él, login deshabilitado).
# AUTH_USERS: "email1:hashBcrypt1,email2:hashBcrypt2" (hashes bcrypt, sin ':' ni ',').
# JWT_TTL: vida del token (opcional, por defecto 8h).
JWT_SECRET=
AUTH_USERS=
JWT_TTL=8h

# Orígenes CORS permitidos (coma-separado). FAIL-CLOSED: si queda vacío, el
# navegador bloqueará las peticiones cross-origin. Fijar el/los origen(es) del portal.
ALLOWED_ORIGIN=https://portal.tu-dominio.com

# Puerto de escucha
PORT=3001

# Observabilidad (opcional): DSN de Sentry. Si se deja vacío, Sentry queda desactivado.
SENTRY_DSN=

# Caché TTL de los endpoints en ms (DATA-002). Por defecto 120000 (2 min).
CACHE_TTL_MS=120000
